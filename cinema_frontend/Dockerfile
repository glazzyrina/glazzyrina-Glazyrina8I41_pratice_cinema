# Используем официальный образ Node.js
FROM node:18-alpine

# Устанавливаем рабочую директорию для фронтенда
WORKDIR /app

# Копируем файлы конфигурации пакетов
COPY package*.json ./

# Устанавливаем зависимости Node.js
RUN npm install

# Копируем весь код веб-сайта в контейнер
COPY . .

# Открываем порт 3000 для работы в браузере
EXPOSE 3000

# Команда для запуска веб-сайта React внутри Docker
CMD ["npm", "start"]
